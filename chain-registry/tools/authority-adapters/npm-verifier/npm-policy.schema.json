{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:creg:npm-authority-policy:v1",
  "title": "CREG npm authority-verifier policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "adapter_id",
    "adapter_version",
    "registry_origin",
    "registry_keys_sha256",
    "sigstore",
    "publish",
    "authentication_mode",
    "publishers",
    "archive"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "authority": {
      "const": "npm_trusted_publisher"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "registry_origin": {
      "const": "https://registry.npmjs.org"
    },
    "registry_keys_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sigstore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance",
        "bundle_media_types"
      ],
      "properties": {
        "instance": {
          "const": "production"
        },
        "bundle_media_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "application/vnd.dev.sigstore.bundle+json;version=0.1",
              "application/vnd.dev.sigstore.bundle+json;version=0.2",
              "application/vnd.dev.sigstore.bundle.v0.3+json"
            ]
          }
        }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_type",
        "predicate_type"
      ],
      "properties": {
        "statement_type": {
          "const": "https://in-toto.io/Statement/v0.1"
        },
        "predicate_type": {
          "const": "https://github.com/npm/attestation/tree/main/specs/publish/v0.1"
        }
      }
    },
    "authentication_mode": {
      "description": "Mandatory fail-closed gate. This schema cannot enable npm authority while the official cryptographic signal is unavailable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "official_cryptographic_signal"
      ],
      "properties": {
        "required": {
          "const": "trusted_publishing_oidc"
        },
        "status": {
          "const": "unavailable"
        },
        "official_cryptographic_signal": {
          "type": "null"
        }
      }
    },
    "publishers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/publisher"
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_prefix",
        "package_manifest_path",
        "max_entries",
        "max_entry_bytes",
        "max_uncompressed_bytes",
        "max_compression_ratio"
      ],
      "properties": {
        "challenge_prefix": {
          "const": "package"
        },
        "package_manifest_path": {
          "const": "package/package.json"
        },
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_entry_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 67108864
        },
        "max_uncompressed_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 536870912
        },
        "max_compression_ratio": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "npmNamespace": {
      "type": "string",
      "minLength": 6,
      "maxLength": 512,
      "pattern": "^npm:(?:@[a-z0-9._~-]+/)?[a-z0-9._~-]+@$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "issuer",
        "subject",
        "provenance_statement_type",
        "provenance_predicate_type"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/npmNamespace"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "provenance_statement_type": {
          "enum": [
            "https://in-toto.io/Statement/v0.1",
            "https://in-toto.io/Statement/v1"
          ]
        },
        "provenance_predicate_type": {
          "enum": [
            "https://slsa.dev/provenance/v0.2",
            "https://slsa.dev/provenance/v1"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance_predicate_type": {
                "const": "https://slsa.dev/provenance/v0.2"
              }
            },
            "required": [
              "provenance_predicate_type"
            ]
          },
          "then": {
            "properties": {
              "provenance_statement_type": {
                "const": "https://in-toto.io/Statement/v0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance_predicate_type": {
                "const": "https://slsa.dev/provenance/v1"
              }
            },
            "required": [
              "provenance_predicate_type"
            ]
          },
          "then": {
            "properties": {
              "provenance_statement_type": {
                "const": "https://in-toto.io/Statement/v1"
              }
            }
          }
        }
      ]
    }
  }
}
