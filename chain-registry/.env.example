# Chain Registry (CREG) Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git - it contains sensitive keys!

# =============================================================================
# VALIDATOR KEYS (CRITICAL - Generate using: cargo run --bin creg -- keygen)
# =============================================================================
# These are Ed25519 private keys for validators
# For testnet testing, you can run multiple validators on one PC
# For production: ONE VALIDATOR PER PC ONLY

# Validator 1 (Primary/Seed Node)
NODE1_VALIDATOR_KEY=your_validator_1_private_key_here

# Validator 2
NODE2_VALIDATOR_KEY=your_validator_2_private_key_here

# Validator 3
NODE3_VALIDATOR_KEY=your_validator_3_private_key_here

# Validator 4 (Optional - for 4+ validator testnet)
NODE4_VALIDATOR_KEY=your_validator_4_private_key_here

# Validator 5 (Optional)
NODE5_VALIDATOR_KEY=your_validator_5_private_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_PASSWORD=secure_postgres_password_change_me

# =============================================================================
# ETHEREUM RPC — Sepolia (default for docker compose)
# =============================================================================
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CREG_ETH_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Additional, independently operated Sepolia RPC endpoints (comma-separated,
# distinct hosts). Security-relevant reads (eth_call, eth_getLogs, eth_chainId,
# ...) require identical answers from a strict majority of ALL configured
# endpoints, so configure either none or at least two here (three providers in
# total). With exactly two providers in total, both must agree on every read.
# Each provider must serve full historical logs from the staking deployment
# block; pruned free tiers fail the validator-set sync.
CREG_ETH_RPC_FALLBACKS=

# Sepolia contracts. Leave these empty: the node adopts the addresses from the
# signature-verified chain spec at startup. A non-empty value that disagrees
# with the signed spec is a hard startup error, so stale values here stop the
# node. Validators (CREG_IS_VALIDATOR=true) still refuse to boot if no staking
# address is available from either source. Set them only for a spec-less
# local network.
CREG_REGISTRY_ADDR=
CREG_STAKING_ADDR=
CREG_GOVERNANCE_ADDR=
CREG_TOKEN_ADDR=
CREG_ZK_VERIFIER_ADDR=
# Package-circuit Groth16 keys (proving_key_package_v2.bin + verifying_key_package_v2.bin).
# Required only if the signed chain spec sets feature_flags.zk_validation=true AND
# CREG_PRODUCTION=true. Sepolia keeps zk_validation false — do not flip it here.
# CREG_ZK_ENABLED / CREG_ZK_CIRCUITS_PATH in compose are unused by creg-node.
# CREG_ZK_KEYS_DIR=/app/circuits
CREG_API_PORT=8090
CREG_IS_VALIDATOR=false

# Bridge account used by the node for Ethereum settlement on Sepolia.
# HOT KEY — never commit real mainnet keys; rotate if exposed (see docs/SECURITY_OPS_RUNBOOK.md).
CREG_BRIDGE_KEY=your_sepolia_bridge_private_key_here

# Set true on testnet/Sepolia nodes to allow dev keys without hot-key startup warnings.
CREG_TESTNET=false

# Explorer dev-mode toggle. Set to false for production-style builds to hide raw private key wallet input.
VITE_DEV_MODE=true

# =============================================================================
# FAUCET CONFIGURATION (Testnet Only)
# =============================================================================
# Faucet private key (Sepolia-funded). HOT KEY — testnet only unless CREG_TESTNET=true.
FAUCET_PRIVATE_KEY=your_sepolia_faucet_private_key_here

# =============================================================================
# RELAYER (sponsored stake)
# =============================================================================
# HOT KEY — same rules as FAUCET_PRIVATE_KEY / CREG_BRIDGE_KEY.
RELAYER_PRIVATE_KEY=your_sepolia_relayer_private_key_here
RELAYER_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional independent fallbacks for RELAYER_RPC_URL (comma-separated, distinct
# hosts; same rules as CREG_ETH_RPC_FALLBACKS). The chain ID and permit-nonce
# reads then need a strict majority of all configured endpoints. Sponsored
# transactions are always submitted to RELAYER_RPC_URL only.
RELAYER_RPC_FALLBACKS=
RELAYER_PORT=8083

# Faucet address (must match FAUCET_PRIVATE_KEY; the faucet refuses to start
# when they differ). Never use a public Anvil/Hardhat default account here.
FAUCET_ADDRESS=your_faucet_address_matching_the_private_key

# Faucet RPC / port
FAUCET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional independent fallbacks for FAUCET_RPC_URL (same rules as
# CREG_ETH_RPC_FALLBACKS). Recipient and faucet balance reads then need a
# strict majority of all configured endpoints. Transfers always go to
# FAUCET_RPC_URL only.
FAUCET_RPC_FALLBACKS=
FAUCET_PORT=8082

# Token contract used by the faucet after deployment
FAUCET_TOKEN_CONTRACT=
# Verified holder addresses from the signed deployment manifest. Required for
# the public, single-block supply breakdown; these do not authorize transfers.
FAUCET_TREASURY_ADDRESS=
FAUCET_GOVERNANCE_ADDRESS=
FAUCET_STAKING_ADDRESS=

# Sepolia history source used to verify the deployment receipt and scan real
# Transfer logs. Configure an endpoint with full token history access.
FAUCET_RECONCILIATION_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional independent fallbacks for FAUCET_RECONCILIATION_RPC_URL (same rules
# as CREG_ETH_RPC_FALLBACKS). Historical balance and supply reads, bytecode,
# chain ID and, when FAUCET_RECONCILIATION_INDEXER_URL is empty, Transfer log
# scans then need a strict majority of all configured endpoints, so one pruned
# provider can neither block reconciliation nor make it pass.
FAUCET_RECONCILIATION_RPC_FALLBACKS=
FAUCET_DEPLOYMENT_RECEIPT_RPC_URL=https://1rpc.io/sepolia
# Indexed Sepolia Transfer history is cross-checked against canonical RPC receipts and contract state.
FAUCET_RECONCILIATION_INDEXER_URL=https://api.routescan.io/v2/network/testnet/evm/11155111/etherscan/api
FAUCET_TOKEN_DEPLOYMENT_TX_HASH=0xb5e4229aef0b76de4b8528283243f4fb668df3820556675452c11b9afc3cb516
FAUCET_TOKEN_DEPLOYMENT_BLOCK=11781432
FAUCET_RECONCILIATION_CONFIRMATIONS=64

# Faucet drip amount (in wei, default: 1000 tCREG)
FAUCET_DRIP_AMOUNT=1000000000000000000000

# Governed faucet budget controls. Keep empty until the approved Governance
# tranche and the existing confirmed faucet transfers have been reconciled
# into the durable PostgreSQL claim ledger. Amounts are in wei.
FAUCET_TOKEN_ALLOCATION_WEI=
FAUCET_TOKEN_DAILY_CAP_WEI=
FAUCET_TOKEN_ADDRESS_LIFETIME_CAP_WEI=
FAUCET_TOKEN_HOT_WALLET_FLOAT_WEI=
# Separate release gate. Budget configuration alone never enables public claims.
# The R28 candidate policy is a 100 tCREG drip, 1m cumulative distribution cap,
# 50k daily cap, 100 per-wallet lifetime cap, and 100k working balance.
FAUCET_TOKEN_DISTRIBUTION_OPEN=false

# Faucet cooldown (seconds between requests)
FAUCET_COOLDOWN_SECS=60

# Optional CIDR allowlist for the real reverse proxy in front of the faucet.
# Forwarded client IP headers are ignored unless the socket peer is in this list.
# On the public Docker stack, set this in the protected faucet.env to the actual
# source subnet used by the Caddy container after checking `docker network inspect`.
FAUCET_TRUSTED_PROXY_CIDRS=

# =============================================================================
# AI/ML — Lane B (validator Stage 4) + Lane C (post-consensus intelligence)
# =============================================================================
# Lane B: semantic review during validate_package (consensus advisory).
# Lane C: async deep analysis after verify (explorer /v1/.../intelligence).
# See docs/PACKAGE_INTELLIGENCE_LANE_C.md

# Enable Stage 4 LLM on validators (default off — requires provider below)
CREG_LLM_ENABLED=false
# Provider order: anthropic,openai,openrouter,ollama
CREG_LLM_PROVIDERS=ollama,openrouter
CREG_LLM_MODEL=llama3.2
CREG_LLM_PROMPT_PROFILE_ID=llm-prompt-v1
CREG_LLM_RATE_LIMIT=20
CREG_OLLAMA_URL=http://127.0.0.1:11434

# Pinned OSV advisories on the consensus hot path (no live api.osv.dev calls).
CREG_OSV_CONSENSUS=false
CREG_OSV_SNAPSHOT_PATH=data/osv_snapshot.json
CREG_OSV_SNAPSHOT_EPOCH=osv-epoch-0
# Block consensus when pinned snapshot reports critical CVE (OSV002). Default advisory-only.
CREG_OSV_BLOCK_CRITICAL=false
# Lane C / off-chain: query live OSV when pinned snapshot misses (never used on consensus path).
CREG_OSV_LIVE_FALLBACK=true

# Lane C worker (operator / one explorer-facing node)
CREG_INTELLIGENCE_ENABLED=false
CREG_INTELLIGENCE_AUTO=true

OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# IPFS CONFIGURATION
# =============================================================================
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8081

# =============================================================================
# NODE CONFIGURATION
# =============================================================================
# Node ID (must be unique per validator)
CREG_NODE_ID=node-1

# P2P listen address
CREG_P2P_LISTEN=/ip4/0.0.0.0/tcp/9000

# P2P bootstrap seeds (comma-separated multiaddrs). Validators refuse to start
# when this is empty unless CREG_TESTNET=true and CREG_ALLOW_EMPTY_P2P_SEEDS=true.
# CREG_VALIDATOR_P2P_SEEDS is an alias used by observer-pool compose.
# Example: /ip4/192.168.1.100/tcp/9000/p2p/12D3KooW...
CREG_P2P_SEEDS=
# CREG_VALIDATOR_P2P_SEEDS=
# CREG_ALLOW_EMPTY_P2P_SEEDS=false

# API port
CREG_API_PORT=8080

# gRPC port
CREG_GRPC_PORT=50051

# Data directory
CREG_DATA_DIR=./data

# PBFT quorum override for small local clusters only. Leave unset/false outside
# local bootstrap; enabling it allows a 3-validator cluster to make progress
# with a 2-of-3 majority instead of strict 3-of-3 quorum.
CREG_PBFT_ALLOW_SMALL_CLUSTER_QUORUM=false

# Weak-subjectivity / certified committee authority. Do not enable either
# setting until operators distribute an independently verified signed
# validator-set transition certificate.
# CREG_WEAK_SUBJECTIVITY_CHECKPOINT='{"schema_version":1,...}'
# CREG_REQUIRE_CERTIFIED_COMMITTEES=false

# Authoritative npm/PyPI namespace ownership (CR-07).
#
# Consensus activation height and accepted adapter/policy/trust-root digests
# MUST come from the signature-verified chain spec. The node rejects
# environment-only activation. These mirrors are useful only for local
# diagnostics while preparing and signing the next chain spec; do not use them
# as an activation mechanism.
# CREG_NAMESPACE_AUTHORITY_ACTIVATION_HEIGHT=
# CREG_NAMESPACE_AUTHORITY_POLICIES=[]
#
# Validator-local verifier processes. Leave both paths empty until the exact
# npm/PyPI verifier binaries and their policy/trust-root bundles have been
# independently reviewed, hashed into the signed chain spec, and rehearsed.
# Paths must be absolute inside the node/container. Empty paths keep authority
# attestation fail-closed.
# CREG_NAMESPACE_AUTHORITY_NPM_VERIFIER_PATH=
# CREG_NAMESPACE_AUTHORITY_PYPI_VERIFIER_PATH=
# CREG_NAMESPACE_AUTHORITY_VERIFIER_TIMEOUT_SECS=30
# CREG_NAMESPACE_AUTHORITY_MAX_EVIDENCE_BYTES=2097152
# CREG_NAMESPACE_AUTHORITY_MAX_ARTIFACT_BYTES=16777216
# CREG_NAMESPACE_AUTHORITY_MAX_RESULT_BYTES=65536
# Default verifier concurrency is 2; values above the hard maximum of 4 fail.
# CREG_NAMESPACE_AUTHORITY_MAX_CONCURRENT_VERIFICATIONS=2
# Evidence and artifacts share one validator-local archive quota. Garbage
# collection occurs only under pressure and only after the minimum retention
# window. Defaults: 10 GiB, 100000 entries, and 365 days.
# CREG_NAMESPACE_AUTHORITY_ARCHIVE_MAX_BYTES=10737418240
# CREG_NAMESPACE_AUTHORITY_ARCHIVE_MAX_ENTRIES=100000
# CREG_NAMESPACE_AUTHORITY_ARCHIVE_MIN_RETENTION_SECS=31536000
#
# Required by both namespace-authority POST routes. Generate a high-entropy
# secret and send it as X-Operator-Key or Authorization: Bearer <token>.
# Never commit the real value or expose it through VITE_* / any browser bundle.
# CREG_OPERATOR_PUBKEY is public verification material and is not accepted as
# a private-route credential.
# CREG_OPERATOR_API_KEY=

# Dedicated Governance.sol signer (secp256k1, 64 hex chars). Required for
# POST /v1/operator/governance/proposals, .../vote, and .../execute.
# Not CREG_BRIDGE_KEY and not CREG_OPERATOR_API_KEY. The address must be an
# on-chain signer. Writes also require CREG_OPERATOR_API_KEY.
# CREG_GOVERNANCE_KEY=
#
# Artifact default is 16 MiB; the protocol hard maximum is 67108864 bytes.
# Exact accepted evidence and separately fetched official artifact bytes are
# archived content-addressably under CREG_DATA_DIR. Evidence is referenced as
# creg-evidence:sha256:<digest>. Never store bearer tokens.

# Legacy CLI publisher signing/multisig is not chain/genesis bound and is
# disabled by default. This explicit escape hatch is accepted only when
# CREG_PRODUCTION is not true and must never be used after CR-07 activation.
CREG_ALLOW_LEGACY_PUBLISHER_PROOF=false

# Experimental shielded publish (`creg publish --shield`). Default off (SEC-304).
# Must be true on both CLI and node when testing threshold encryption.
# CREG_SHIELDED_PUBLISH_ENABLED=false

# Hot secp256k1 keys — env (default) or HashiCorp Vault (SEC-301b). See docs/adr/ADR-KMS-HOT-KEYS.md
# CREG_SECRETS_BACKEND=env
# CREG_SECRETS_BACKEND=vault
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=dev-only-token
# CREG_VAULT_SECRET_PATH_BRIDGE=secret/data/creg/bridge
# CREG_VAULT_SECRET_PATH_FAUCET=secret/data/creg/faucet
# CREG_VAULT_SECRET_PATH_RELAYER=secret/data/creg/relayer
# CREG_VAULT_SECRET_FIELD=private_key

# =============================================================================
# TESTNET CONTRACT ADDRESSES (Auto-populated after deployment)
# =============================================================================
# These are populated by testnet/deploy-testnet.sh
TESTNET_TOKEN_ADDR=
TESTNET_STAKING_ADDR=
TESTNET_REGISTRY_ADDR=
TESTNET_GOVERNANCE_ADDR=
TESTNET_REPUTATION_ADDR=
TESTNET_VRF_ADDR=
TESTNET_APPEAL_ADDR=

# =============================================================================
# LOGGING
# =============================================================================
RUST_LOG=info,chain_registry_node=debug
