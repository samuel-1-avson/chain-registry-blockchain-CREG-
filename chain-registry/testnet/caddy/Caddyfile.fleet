# Public-services layout: validators run independently; edge services run on this VM.
# API proxies only to the GCP observer read pool (Phase 2 ILB).
#
# Requires: CREG_OBSERVER_API_UPSTREAM (host:port) — set by start-cloud-edge-gcp.sh

{
	email {$CREG_ACME_EMAIL}
}

import waitlist.caddy
import faucet-edge.caddy
import hub.caddy

# HTTP for Google external HTTPS LB backends (LB terminates TLS; do not redirect to HTTPS).
http://{$CREG_PUBLIC_API_HOST} {
	import creg-node-jsonrpc.caddy
	handle /metrics* {
		header Content-Type application/json
		respond `{"error":"forbidden","message":"Node Prometheus metrics are operator-internal only."}` 403
	}
	reverse_proxy {$CREG_OBSERVER_API_UPSTREAM} {
		flush_interval -1
	}
}

{$CREG_PUBLIC_API_HOST} {
	import creg-node-jsonrpc.caddy
	handle /metrics* {
		header Content-Type application/json
		respond `{"error":"forbidden","message":"Node Prometheus metrics are operator-internal only."}` 403
	}
	reverse_proxy {$CREG_OBSERVER_API_UPSTREAM} {
		flush_interval -1
	}
}

{$CREG_PUBLIC_EXPLORER_HOST} {
	handle {
		reverse_proxy 127.0.0.1:{$CREG_3NODE_EXPLORER_PORT} {
			flush_interval -1
		}
	}
}

{$CREG_PUBLIC_SPEC_HOST} {
	reverse_proxy 127.0.0.1:{$CREG_3NODE_SPEC_HOST_PORT}
}

{$CREG_PUBLIC_IPFS_HOST} {
	reverse_proxy 127.0.0.1:{$CREG_3NODE_IPFS_HOST_PORT}
}
