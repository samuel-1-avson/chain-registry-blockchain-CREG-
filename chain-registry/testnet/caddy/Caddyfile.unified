# ==============================================================================
# Unified CREG + Sepolia RPC Caddy Gateway
# Runs on a single cost-optimized GCP VM (e2-standard-2, ~$59/month)
# Serves both CREG native blockchain JSON-RPC and upstream Sepolia L1 RPC.
# ==============================================================================

{
	email {$CREG_ACME_EMAIL}
}

import waitlist.caddy
import hub.caddy

# ── Unified API & RPC Gateway ──────────────────────────────────────────────────
# Serves both api.testnet.cregnet.dev and rpc.testnet.cregnet.dev
{$CREG_PUBLIC_API_HOST}, rpc.testnet.cregnet.dev {
	encode zstd gzip

	# 1. Sepolia L1 Proxy (POST /sepolia) -> Allowlisted Explorer /rpc Gateway.
	# The gateway's own upstream (explorer CREG_SEPOLIA_RPC_UPSTREAM) must be a
	# real Sepolia RPC, never this route; X-CREG-Edge-Hop refuses a loop.
	handle_path /sepolia* {
		@jsonrpc_post method POST
		handle @jsonrpc_post {
			# ADR-019 ECA-38: 64 KB body cap + route through explorer njs method allowlist & rate limiter.
			request_body {
				max_size 64KB
			}
			@rpc_gateway_loop header X-CREG-Edge-Hop *
			header @rpc_gateway_loop Content-Type application/json
			respond @rpc_gateway_loop `{"jsonrpc":"2.0","id":null,"error":{"code":-32603,"message":"RPC gateway loop refused: the explorer RPC upstream points back at the edge"}}` 508
			rewrite * /rpc
			reverse_proxy {$CREG_EXPLORER_RPC_GATEWAY:creg-explorer-public-r28:80} {
				header_up X-CREG-Edge-Hop sepolia
				flush_interval -1
			}
		}
		header Content-Type application/json
		respond `{"service":"CREG Unified L1 RPC Gateway","network":"sepolia","chainId":"0xaa36a7","numericChainId":11155111,"usage":"POST allowlisted JSON-RPC 2.0 eth_* methods here"}` 200
	}

	# 2. CREG Blockchain JSON-RPC (POST /rpc or POST /jsonrpc) -> Dedicated Observer VM
	# OPTIONS goes to the node too, so a browser's CORS preflight is answered by
	# the node's CORS layer (CREG_CORS_ALLOWED_ORIGINS) rather than by the
	# descriptor below, which carries no CORS headers.
	@creg_rpc_path path /rpc* /jsonrpc*
	handle @creg_rpc_path {
		@jsonrpc_post method POST OPTIONS
		handle @jsonrpc_post {
			reverse_proxy {$CREG_PUBLIC_NODE_UPSTREAM:creg-phase-c-r7-o1:8080} {
				lb_policy first
				fail_duration 5s
				max_fails 2
				flush_interval -1
			}
		}
		header Content-Type application/json
		respond `{"service":"CREG Blockchain JSON-RPC","network":"creg-testnet","methods":["creg_chainId","creg_blockNumber","creg_getBlockByNumber","creg_health","creg_syncing"],"sepoliaL1Gateway":"https://{$CREG_PUBLIC_API_HOST}/sepolia"}` 200
	}

	# 2c. Indexer read model (/v1/index/*) -> standalone creg-indexer.
	# Plain `handle`, not `handle_path`: the indexer serves the full
	# /v1/index/... path itself, so the prefix must not be stripped.
	handle /v1/index/* {
		reverse_proxy {$CREG_INDEXER_UPSTREAM:creg-indexer:8084} {
			lb_policy first
			fail_duration 5s
			max_fails 2
		}
	}

	# 3. CREG Node REST API (/v1/*) & Health -> Dedicated Observer VM
	handle /v1/* {
		reverse_proxy {$CREG_PUBLIC_NODE_UPSTREAM:creg-phase-c-r7-o1:8080} {
			lb_policy first
			fail_duration 5s
			max_fails 2
			flush_interval -1
		}
	}
	handle /health {
		rewrite * /v1/health
		reverse_proxy {$CREG_PUBLIC_NODE_UPSTREAM:creg-phase-c-r7-o1:8080} {
			lb_policy first
			fail_duration 5s
			max_fails 2
			flush_interval -1
		}
	}

	# ADR-019 ECA-39: never proxy node /metrics on the public edge.
	handle /metrics* {
		header Content-Type application/json
		respond `{"error":"forbidden","message":"Node Prometheus metrics are operator-internal only."}` 403
	}

	# Default API root response
	handle {
		header Content-Type application/json
		respond `{"name":"Chain Registry Unified API Gateway","version":"1.0.0","endpoints":{"creg_rpc":"/rpc","sepolia_l1_rpc":"/sepolia","rest_api":"/v1","health":"/v1/health"}}` 200
	}
}

# ── Explorer Frontend & Allowlisted Wallet RPC (/rpc enforced by explorer nginx+njs) ──
{$CREG_PUBLIC_EXPLORER_HOST} {
	encode zstd gzip
	handle {
		reverse_proxy creg-explorer-public-r28:80 {
			flush_interval -1
		}
	}
}

# ── Spec Server ───────────────────────────────────────────────────────────────
{$CREG_PUBLIC_SPEC_HOST} {
	# Compatibility for previously installed CLI configurations using this API base.
	handle_path /ipfs/* {
		reverse_proxy ipfs:5001
	}
	# Make the signed R7 spec the default for new clients and existing root-URL
	# installers. The legacy spec remains available from the preserved old host.
	handle /chain-spec.json {
		rewrite * /phase-c/r7/chain-spec.json
		reverse_proxy spec-server:80
	}
	handle /chain-spec.json.sig {
		rewrite * /phase-c/r7/chain-spec.json.sig
		reverse_proxy spec-server:80
	}
	handle {
		reverse_proxy spec-server:80
	}
}

# ── IPFS Gateway ──────────────────────────────────────────────────────────────
{$CREG_PUBLIC_IPFS_HOST} {
	@ipfs_content path /ipfs/* /ipns/*
	handle @ipfs_content {
		reverse_proxy ipfs:8080
	}
	handle {
		reverse_proxy ipfs:5001
	}
}

# ── Faucet Service ────────────────────────────────────────────────────────────
{$CREG_PUBLIC_FAUCET_HOST} {
	import sepolia-public-rpc.caddy
	handle {
		reverse_proxy faucet:8082 {
			flush_interval -1
		}
	}
}
