# Shared Sepolia L1 JSON-RPC proxy (eth_*). Imported by faucet-edge and similar vhosts.
# GET/HEAD: JSON descriptor (browser-friendly). POST: route through the explorer
# image's njs-allowlisted /rpc gateway (ADR-019 ECA-38). The gateway's own
# upstream (CREG_SEPOLIA_RPC_UPSTREAM in the explorer container) must be a real
# Sepolia RPC, never this edge: X-CREG-Edge-Hop marks the forwarded request and a
# request that comes back carrying it is refused instead of looping.
handle_path /rpc* {
	@jsonrpc method POST
	handle @jsonrpc {
		request_body {
			max_size 64KB
		}
		@rpc_gateway_loop header X-CREG-Edge-Hop *
		header @rpc_gateway_loop Content-Type application/json
		respond @rpc_gateway_loop `{"jsonrpc":"2.0","id":null,"error":{"code":-32603,"message":"RPC gateway loop refused: the explorer RPC upstream points back at the edge"}}` 508
		rewrite * /rpc
		reverse_proxy {$CREG_EXPLORER_RPC_GATEWAY:creg-explorer-public-r27-stage:80} {
			header_up X-CREG-Edge-Hop sepolia-rpc
			flush_interval -1
		}
	}
	header Content-Type application/json
	respond `{"service":"CREG Sepolia L1 JSON-RPC","chainId":"0xaa36a7","usage":"POST allowlisted JSON-RPC 2.0 eth_* methods to this URL","example":{"jsonrpc":"2.0","method":"eth_chainId","params":[],"id":1}}` 200
}
