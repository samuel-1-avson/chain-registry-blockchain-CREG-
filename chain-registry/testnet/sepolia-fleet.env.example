# Chain Registry — Sepolia maintainer fleet env (edge + optional seed validators)
#
# Quick start:
#   .\testnet\init-sepolia-fleet-env.ps1
#   .\testnet\start-validator-fleet-gcp.sh
#
# Manual copy:
#   Copy-Item testnet\sepolia-fleet.env.example testnet\sepolia-fleet.env
#
# Scale testnet architecture: docs/TESTNET_SCALE_ARCHITECTURE.md

# ── Sepolia RPC (required) ──
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CREG_ETH_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Option A internal Geth: docs/GCP-SEPOLIA-GETH-INTERNAL.md
# SEPOLIA_RPC_URL=http://10.128.0.X:8545
# CREG_ETH_RPC=http://10.128.0.X:8545

# ── Validator fleet mode (seed validators on creg-validator-vm) ──
# See docs/GCP-VALIDATOR-FLEET.md — optional; external operators run their own hosts.
# CREG_VALIDATOR_FLEET_MODE=true
# CREG_VALIDATOR_VM_INTERNAL_IP=10.128.0.X
# CREG_EDGE_INTERNAL_IP=10.128.0.Y
# CREG_IPFS_URL=http://10.128.0.Y:15001
# CREG_CHAIN_SPEC_URL=http://10.128.0.Y:18888/chain-spec.json

# Fleet service ports (host on validator VM)
CREG_FLEET_NODE1_API_PORT=28180
CREG_FLEET_NODE1_P2P_PORT=29100
CREG_FLEET_NODE2_API_PORT=28181
CREG_FLEET_NODE2_P2P_PORT=29101
CREG_FLEET_OBSERVER_API_PORT=28182
CREG_FLEET_OBSERVER_P2P_PORT=29102
CREG_FLEET_IPFS_HOST_PORT=15001
CREG_FLEET_SPEC_HOST_PORT=18888

# Backward-compatible aliases (compose may still read these)
CREG_3NODE_NODE1_API_PORT=28180
CREG_3NODE_NODE1_P2P_PORT=29100
CREG_3NODE_NODE2_API_PORT=28181
CREG_3NODE_NODE2_P2P_PORT=29101
CREG_3NODE_NODE3_API_PORT=28182
CREG_3NODE_NODE3_P2P_PORT=29102
CREG_3NODE_IPFS_HOST_PORT=15001
CREG_3NODE_SPEC_HOST_PORT=18888

CREG_DEV_SANDBOX=false

# Weak-subjectivity rollout (keep mandatory mode disabled until the exact
# signed checkpoint has been independently verified and rehearsed fleet-wide).
# CREG_WEAK_SUBJECTIVITY_CHECKPOINT={"schema_version":1,...}
CREG_REQUIRE_CERTIFIED_COMMITTEES=false

# CR-07 stays fail-closed until real verifier binaries and policy/trust-root
# bundles have independent review. Activation/policy pins belong in the signed
# chain spec; do not attempt to activate them with environment variables.
# CREG_NAMESPACE_AUTHORITY_NPM_VERIFIER_PATH=/opt/creg-authority/npm-verifier
# CREG_NAMESPACE_AUTHORITY_PYPI_VERIFIER_PATH=/opt/creg-authority/pypi-verifier
CREG_NAMESPACE_AUTHORITY_VERIFIER_TIMEOUT_SECS=30
CREG_NAMESPACE_AUTHORITY_MAX_EVIDENCE_BYTES=2097152
CREG_NAMESPACE_AUTHORITY_MAX_ARTIFACT_BYTES=16777216
CREG_NAMESPACE_AUTHORITY_MAX_RESULT_BYTES=65536
# Hard maximum 4.
CREG_NAMESPACE_AUTHORITY_MAX_CONCURRENT_VERIFICATIONS=2

# CREG_BRIDGE_KEY=0x...
# Required for authority attestation/certificate routes. Use a high-entropy
# secret through X-Operator-Key or Authorization: Bearer; never use this sample
# or expose the secret through VITE_* / any browser bundle.
# CREG_OPERATOR_PUBKEY is public and cannot authenticate private routes.
# CREG_OPERATOR_API_KEY=replace-with-random-secret

# Explicit pre-activation CLI compatibility only; never enable on a production
# or CR-07-activated network.
CREG_ALLOW_LEGACY_PUBLISHER_PROOF=false

CREG_VALIDATOR_KEY_1=0xREPLACE_WITH_VALIDATOR_1_ED25519_SEED
CREG_VALIDATOR_KEY_2=0xREPLACE_WITH_VALIDATOR_2_ED25519_SEED

# CREG_ACME_EMAIL=you@example.com
# CREG_PUBLIC_BASE_DOMAIN=testnet.YOUR_DOMAIN
# CREG_PUBLIC_API_HOST=api.testnet.YOUR_DOMAIN
