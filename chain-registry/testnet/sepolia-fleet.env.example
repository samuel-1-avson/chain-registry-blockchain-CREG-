# Chain Registry — Sepolia external-validator observer env
#
# Quick start:
#   .\testnet\init-sepolia-fleet-env.ps1
#   .\testnet\start-observer-pool-gcp.sh
#
# Manual copy:
#   Copy-Item testnet\sepolia-fleet.env.example testnet\sepolia-fleet.env
#
# Scale testnet architecture: docs/archive/TESTNET_SCALE_ARCHITECTURE.md (archived 2026-09-19)

# ── Sepolia RPC (required) ──
# R7 RPC profile: public HTTPS providers plus a GCP-hosted Sepolia Geth node.
# Google Blockchain RPC new endpoint provisioning is closed; service shutdown
# is scheduled for 2026-12-15. Keep any deployed Geth endpoint in Secret Manager.
# CREG_ETH_RPC=https://ethereum-sepolia-rpc.publicnode.com
# CREG_ETH_RPC_FALLBACKS=https://sepolia.gateway.tenderly.co,http://<allowlisted-gcp-geth-ip>:8545

# ── External validators and bootnodes (required for observers) ──
# These endpoints are supplied out of band by independently controlled operators.
# Do not put validator private keys in this file or on GCP.
# CREG_VALIDATOR_P2P_SEEDS=/dns4/bootnode-1.example/tcp/9000,/dns4/bootnode-2.example/tcp/9000
# CREG_VALIDATOR_HTTP_PEERS=https://validator-1.example,https://validator-2.example
# CREG_EDGE_INTERNAL_IP=10.128.0.Y
# CREG_IPFS_URL=http://10.128.0.Y:15001
# CREG_CHAIN_SPEC_URL=http://10.128.0.Y:18888/chain-spec.json

# Observer service ports (host on each GCP observer VM)
CREG_OBSERVER_POOL_API_PORT=28182
CREG_OBSERVER_POOL_P2P_PORT=29102
CREG_3NODE_NODE3_API_PORT=28182
CREG_3NODE_NODE3_P2P_PORT=29102

# Edge service ports (the edge VM owns IPFS and the spec server)
CREG_3NODE_IPFS_HOST_PORT=15001
CREG_3NODE_SPEC_HOST_PORT=18888

CREG_DEV_SANDBOX=false

# Release integrity: use an immutable, independently verified GHCR digest for
# production observers. Set CREG_OBSERVER_BUILD=1 only for a reviewed source
# build during rehearsal; never deploy a mutable :latest tag in public mode.
CREG_REQUIRE_SIGNED_IMAGES=true
# CREG_FLEET_IMAGE=ghcr.io/chain-registry/chain-registry@sha256:<approved-digest>

# Weak-subjectivity rollout (keep mandatory mode disabled until the exact
# signed checkpoint has been independently verified and rehearsed fleet-wide).
# CREG_WEAK_SUBJECTIVITY_CHECKPOINT={"schema_version":1,...}
CREG_REQUIRE_CERTIFIED_COMMITTEES=false

# CR-07 stays fail-closed until real verifier binaries and policy/trust-root
# bundles have independent review. Activation/policy pins belong in the signed
# chain spec; do not attempt to activate them with environment variables.
# CREG_NAMESPACE_AUTHORITY_NPM_VERIFIER_PATH=/opt/creg-authority/npm-verifier
# CREG_NAMESPACE_AUTHORITY_PYPI_VERIFIER_PATH=/opt/creg-authority/pypi-verifier
CREG_NAMESPACE_AUTHORITY_VERIFIER_TIMEOUT_SECS=30
CREG_NAMESPACE_AUTHORITY_MAX_EVIDENCE_BYTES=2097152
CREG_NAMESPACE_AUTHORITY_MAX_ARTIFACT_BYTES=16777216
CREG_NAMESPACE_AUTHORITY_MAX_RESULT_BYTES=65536
# Hard maximum 4.
CREG_NAMESPACE_AUTHORITY_MAX_CONCURRENT_VERIFICATIONS=2
CREG_NAMESPACE_AUTHORITY_ARCHIVE_MAX_BYTES=10737418240
CREG_NAMESPACE_AUTHORITY_ARCHIVE_MAX_ENTRIES=100000
CREG_NAMESPACE_AUTHORITY_ARCHIVE_MIN_RETENTION_SECS=31536000

# CREG_BRIDGE_KEY=0x...
# Required for authority attestation/certificate routes. Use a high-entropy
# secret through X-Operator-Key or Authorization: Bearer; never use this sample
# or expose the secret through VITE_* / any browser bundle.
# CREG_OPERATOR_PUBKEY is public and cannot authenticate private routes.
# CREG_OPERATOR_API_KEY=replace-with-random-secret

# Explicit pre-activation CLI compatibility only; never enable on a production
# or CR-07-activated network.
CREG_ALLOW_LEGACY_PUBLISHER_PROOF=false

# Validator keys are never stored in this GCP observer environment. Each
# independent operator injects its own key into its own validator process.

# CREG_ACME_EMAIL=you@example.com
# CREG_PUBLIC_BASE_DOMAIN=testnet.YOUR_DOMAIN
# CREG_PUBLIC_API_HOST=api.testnet.YOUR_DOMAIN
# Bootstrap the public-service layer before an observer/validator is online.
# Set this only for the first edge bring-up; switch it back to false after the
# observer ILB is ready so CREG API routes become observer-backed.
CREG_PUBLIC_SERVICES_BOOTSTRAP=false
# CREG_PUBLIC_EXPLORER_HOST=explorer.testnet.YOUR_DOMAIN
# CREG_PUBLIC_SPEC_HOST=spec.testnet.YOUR_DOMAIN
# CREG_PUBLIC_IPFS_HOST=ipfs.testnet.YOUR_DOMAIN
# CREG_PUBLIC_FAUCET_HOST=faucet.testnet.YOUR_DOMAIN
# FAUCET_ADDRESS=0x...
# Inject FAUCET_PRIVATE_KEY from an approved secret path (or configure the
# reviewed CREG_SECRETS_BACKEND); never commit a plaintext faucet key.
