# Example Prometheus config for GCP public services.
# Copy or generate via:
#   .\testnet\gcp\deploy-monitoring.ps1
#
# Replace OBSERVER_API_UPSTREAM with the observer API address.

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: creg-testnet-gcp
    environment: public-alpha

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - "alerts.yml"

scrape_configs:
  - job_name: creg-node
    static_configs:
      - targets:
          - "OBSERVER_API_UPSTREAM"
        labels:
          role: observer
    metrics_path: /metrics
    scrape_interval: 15s
    scrape_timeout: 10s

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
