FROM creg-node:recovery-diagnostic-builder-r18 AS builder
WORKDIR /build
COPY ["crates/node/src/state.rs", "crates/node/src/sync.rs", "crates/node/src/pending_pool.rs", "/build/crates/node/src/"]
RUN --mount=type=cache,id=creg-phase-c-release,target=/build/target,sharing=locked \
    env -u RUSTFLAGS -u CARGO_ENCODED_RUSTFLAGS \
    LIBCLANG_PATH=/usr/lib/llvm-17/lib LLVM_CONFIG_PATH=/usr/bin/llvm-config-17 \
    CLANG_PATH=/usr/bin/clang-17 CARGO_BUILD_JOBS=1 RUST_BACKTRACE=1 \
    cargo build --release --locked --package chain-registry-node --bin creg-node --bin creg_recovery_inspect --features phase-c-real-fleet && \
    cp /build/target/release/creg-node /build/output/creg-node && \
    cp /build/target/release/creg_recovery_inspect /build/output/creg_recovery_inspect
FROM creg-node:phase-c-secure-r18-canonical-round-recovery AS cli
FROM creg-node:phase-c-secure-r12-bounded-l1-retry
LABEL org.opencontainers.image.version="phase-c-r19-canonical-admission-retirement"
USER root
COPY --from=cli --chown=creg:creg /app/creg /app/creg
COPY --from=builder --chown=creg:creg /build/output/creg-node /app/creg-node
COPY --from=builder --chown=creg:creg /build/output/creg_recovery_inspect /app/creg_recovery_inspect
USER creg
ENTRYPOINT ["/app/creg-node"]
